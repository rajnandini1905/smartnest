# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smartnest?retryWrites=true&w=majority

# JWT Signing Secret (generate a strong random secret)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Port (5001 for local dev to avoid macOS AirPlay conflict, or Render dynamic port)
PORT=5001

# Allowed Frontend URL for CORS (e.g. http://localhost:5173 or https://smartnest-frontend-4to4.onrender.com)
FRONTEND_URL=http://localhost:5173
